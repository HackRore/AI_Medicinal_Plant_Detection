			border: 1px solid rgba(255,255,255,0.07);
		}

		#mobile-search .tie-google-search form.gsc-search-box{
			padding: 4px 15px !important;
			border-radius: 50px !important;
			background-color: rgba(0,0,0,0.05) !important;
